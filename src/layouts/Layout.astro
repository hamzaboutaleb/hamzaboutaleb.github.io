---
import { contact } from '../data/contact';
import SocialIcon from '../components/SocialIcon.astro';
import DestinationNav from '../components/DestinationNav.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  home?: boolean;
  blogSearch?: boolean;
}
const { title, description, type = 'website', publishedTime, home = false, blogSearch = false } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageURL = Astro.site ? new URL('/social-preview.png', Astro.site) : undefined;
const socialImageAlt = 'Hamza Boutaleb — Software engineer. Curious about how things work.';
const footerLinks = [
  { label: 'GitHub', href: contact.github },
  { label: 'LinkedIn', href: contact.linkedin },
  { label: 'Email', href: contact.email ? `mailto:${contact.email}` : '' },
].filter(link => link.href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      :root { --background: #faf9f6; --text: #222; --muted: #666; --subtle: #888; --border: #ddd; --accent: #2563eb; color-scheme: light; }
      :root[data-theme='dark'] { --background: #1c1b1a; --text: #eee; --muted: #aaa; --subtle: #999; --border: #3b3b3b; --accent: #8ab4ff; color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) { --background: #1c1b1a; --text: #eee; --muted: #aaa; --subtle: #999; --border: #3b3b3b; --accent: #8ab4ff; color-scheme: dark; }
      }
      html, body { background: var(--background); color: var(--text); }
    </style>
    <script is:inline>
      (() => {
        if (window.__portfolioAppearance) { window.__portfolioAppearance(); return; }
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        let preference = null;
        try {
          const saved = localStorage.getItem('portfolio-theme');
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {}

        const applyTheme = (target = document) => {
          const theme = preference || (system.matches ? 'dark' : 'light');
          target.documentElement.dataset.theme = theme;
          const toggle = target.getElementById('theme-toggle');
          if (toggle) {
            const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
            toggle.setAttribute('aria-label', label);
            toggle.setAttribute('title', label);
          }
        };
        const applyAppearance = (target = document) => {
          applyTheme(target);
          let size = 'normal';
          try { if (localStorage.getItem('portfolio-reading-size') === 'large') size = 'large'; } catch {}
          target.documentElement.dataset.readingSize = size;
          delete target.documentElement.dataset.focusMode;
        };
        window.__portfolioAppearance = () => applyAppearance();
        applyAppearance();
        system.addEventListener('change', () => applyTheme());
        document.addEventListener('astro:before-swap', event => {
          // Astro swaps root attributes: prime the incoming document before that happens.
          if (event.newDocument) applyAppearance(event.newDocument);
          // Inner-page navigation does not move the identity or menu.
          if (event.from && event.to && event.from.pathname !== '/' && event.to.pathname !== '/') {
            event.viewTransition?.ready?.catch(() => {});
            event.viewTransition?.skipTransition();
          }
        });
        document.addEventListener('astro:after-swap', () => applyAppearance());
        document.addEventListener('astro:page-load', () => {
          const toggle = document.getElementById('theme-toggle');
          if (!toggle) return;
          toggle.hidden = false;
          applyTheme();
          toggle.onclick = () => {
            preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('portfolio-theme', preference); } catch {}
            applyTheme();
          };
        });
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="author" content="Hamza Boutaleb" />
    <meta name="google-site-verification" content="xc00xwSCT9sWqhm4pPCl1rC2QA6Fvv_IAzrJi3oireE" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:site_name" content="Hamza Boutaleb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {socialImageURL && <>
      <meta property="og:image" content={socialImageURL} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
    </>}
    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageURL && <>
      <meta name="twitter:image" content={socialImageURL} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ 'has-blog-search': blogSearch }}>
    <div class:list={['appearance', { 'has-search': blogSearch }]}>
      {!home && <a class="home-link" href="/" aria-label="Hamza Boutaleb, back to home"><span class="name-first">Hamza</span> <span class="name-last">Boutaleb<span class="underscore" aria-hidden="true">_</span></span></a>}
      {blogSearch && <form class="blog-search" role="search" aria-label="Search blog" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4 4" /></svg>
        <input id="blog-search" type="search" placeholder="Search posts…" aria-label="Search articles by title, summary, or tag" aria-controls="blog-post-list" autocomplete="off" />
        <button id="clear-search-input" type="button" aria-label="Clear search" title="Clear search" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m7 7 10 10M17 7 7 17" /></svg></button>
      </form>}
      <button id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" /></svg>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
    <main class:list={['container', { home }]}>
      {home ? <slot /> : <><DestinationNav compact /><div class="page-content"><slot /></div></>}
    </main>
    <footer class="site-footer">
      <small>© {new Date().getFullYear()} Hamza Boutaleb</small>
      {footerLinks.length > 0 && (
        <nav class="footer-links" aria-label="Social and contact links">
          {footerLinks.map(link => <a href={link.href}><SocialIcon name={link.label} />{link.label}</a>)}
        </nav>
      )}
    </footer>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { font-family: 'Manrope', system-ui, sans-serif; color: var(--text); background: var(--background); line-height: 1.6; scrollbar-gutter: stable; }
  body { margin: 0; min-height: 100vh; min-height: 100svh; display: grid; grid-template-rows: 64px 1fr auto; }
  :root[data-focus-mode='true'] body { grid-template-rows: 1fr; }
  :root[data-focus-mode='true'] .appearance,
  :root[data-focus-mode='true'] main > .destinations,
  :root[data-focus-mode='true'] .site-footer { display: none; }
  :root[data-focus-mode='true'] .page-content { padding-top: 40px; }
  .container { width: 100%; max-width: 960px; margin: 0 auto; padding: 24px 24px 64px; }
  .page-content { view-transition-name: page-content; width: 100%; padding-top: 56px; }
  .container.home { padding-block: clamp(40px, 8vw, 88px); display: flex; flex-direction: column; justify-content: center; }
  h1 { margin: 0; font-size: 2.5rem; font-weight: 700; line-height: 1.1; letter-spacing: -0.05em; overflow-wrap: anywhere; }
  p { margin: 16px 0 0; color: var(--muted); }
  a { color: inherit; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; margin-bottom: 48px; font-size: 0.875rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); text-decoration: underline; text-underline-offset: 5px; }
  .appearance { height: 64px; width: 100%; max-width: 960px; padding: 0 24px; margin: 0 auto; display: flex; align-items: center; justify-content: flex-end; }
  .appearance.has-search { display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 320px) minmax(0, 1fr); gap: 24px; }
  .has-search .home-link { margin-right: 0; justify-self: start; }
  .has-search #theme-toggle { grid-column: 3; grid-row: 1; justify-self: end; }
  .blog-search { display: flex; align-items: center; gap: 10px; height: 44px; min-width: 0; padding: 0 8px 0 14px; border: 1px solid transparent; border-radius: 10px; color: var(--muted); background: color-mix(in srgb, var(--text) 4%, var(--background)); transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .blog-search[hidden] { display: none; }
  .blog-search svg { width: 16px; height: 16px; flex-shrink: 0; }
  .blog-search input { width: 100%; min-width: 0; padding: 8px 0; border: 0; outline: none; color: var(--text); background: transparent; font: inherit; font-size: 0.8125rem; }
  .blog-search input::placeholder { color: var(--muted); }
  .blog-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .blog-search:hover { border-color: var(--border); }
  .blog-search:focus-within { border-color: var(--accent); background: var(--background); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent); }
  .blog-search:focus-within > svg { color: var(--accent); }
  #clear-search-input { width: 32px; height: 32px; flex-shrink: 0; padding: 8px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  #clear-search-input svg { display: block; }
  #clear-search-input:hover { color: var(--text); background: color-mix(in srgb, var(--text) 6%, var(--background)); }
  #clear-search-input:focus-visible { outline-offset: -2px; }
  @media (max-width: 640px) {
    body.has-blog-search { grid-template-rows: auto 1fr auto; }
    .appearance.has-search { height: auto; min-height: 64px; grid-template-columns: minmax(0, 1fr) 44px; gap: 12px; padding-block: 10px; }
    .has-search #theme-toggle { grid-column: 2; grid-row: 1; }
    .blog-search { grid-column: 1 / -1; grid-row: 2; }
  }
  .home-link { margin-right: auto; font-size: 0.8125rem; font-weight: 600; text-decoration: none; }
  .home-link .underscore { color: var(--accent); }
  .name-first { display: inline-block; view-transition-name: identity-first; }
  .name-last { display: inline-block; white-space: nowrap; view-transition-name: identity-last; }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .underscore { animation: cursor-blink 1.6s step-end 3; }
    :root:active-view-transition .underscore { animation: none; opacity: 1; }
  }
  #theme-toggle { width: 44px; height: 44px; color: var(--muted); background: transparent; border: 1px solid var(--border); border-radius: 50%; padding: 11px; cursor: pointer; }
  #theme-toggle:hover { color: var(--text); border-color: var(--subtle); }
  #theme-toggle svg { width: 20px; height: 20px; }
  .theme-moon { display: block; }
  .theme-sun { display: none; }
  :root[data-theme='dark'] .theme-moon { display: none; }
  :root[data-theme='dark'] .theme-sun { display: block; }
  .site-footer { width: calc(100% - 48px); max-width: 912px; min-height: 64px; margin: 0 auto; padding: 20px 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; color: var(--muted); }
  .site-footer small { font-size: 0.75rem; }
  .footer-links { margin: 0; gap: 20px; font-size: 0.75rem; }
  .footer-links a { position: relative; display: inline-flex; align-items: center; gap: 7px; padding: 6px 0; text-decoration: none; transition: color 180ms ease; }
  .footer-links a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .footer-links svg { width: 15px; height: 15px; flex-shrink: 0; }
  .footer-links a:is(:hover, :focus-visible) { color: var(--accent); text-decoration: none; }
  .footer-links a:is(:hover, :focus-visible)::after { transform: scaleX(1); }
  ::view-transition { background: var(--background); }
  ::view-transition-image-pair(*) { isolation: isolate; }
  ::view-transition-old(*) { animation: none; opacity: 0; mix-blend-mode: normal; }
  ::view-transition-new(*) { animation: none; opacity: 1; mix-blend-mode: normal; }
  ::view-transition-group(home-intro),
  ::view-transition-group(page-content) { animation: none; }
  ::view-transition-group(destination-nav),
  ::view-transition-group(identity-first),
  ::view-transition-group(identity-last),
  ::view-transition-group(nav-projects),
  ::view-transition-group(nav-blog),
  ::view-transition-group(nav-about),
  ::view-transition-group(nav-contact) {
    animation-duration: 480ms;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-search { transition: none; }
    .footer-links a, .footer-links a::after { transition: none; }
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none; }
  }
</style>
