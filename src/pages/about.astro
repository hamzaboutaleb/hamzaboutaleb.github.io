---
import Layout from '../layouts/Layout.astro';
const experience = [
  { period: 'Aug – Sep 2026', role: 'Software Developer Intern', organization: 'HPS', details: [
    'Contributed to feature updates and bug fixes in PowerCARD Switch using Java and Spring Boot microservices.',
    'Built a C HTTP service for POS terminal requests using libevhtp and json-c, with Oracle database connectivity.',
  ] },
  { period: 'Jul – Oct 2022', role: 'Web Developer Intern', organization: 'ICF Communication', details: [
    'Developed backend features with PHP and Laravel and built frontend pages with HTML and CSS for a digital marketing agency.',
  ] },
];
const education = [
  { period: 'Oct 2024 – Oct 2026', organization: '1337', category: 'Technical training', title: 'Software Engineering', description: 'C, C++, algorithms, Unix, networking, Java, Spring Boot, microservices, Kafka, and Angular.' },
  { period: 'Apr 2024 – Apr 2026', organization: 'Zone01 Oujda', category: 'Technical training', title: 'Software Development Program', description: 'Go, JavaScript, Rust, Java, and Spring Boot, alongside soft skills training.' },
  { period: 'Feb 2023 – Mar 2024', organization: 'ALX', category: 'Technical training', title: 'Software Engineering Program · Backend Specialization', description: 'C, Python, JavaScript, data structures and algorithms, Linux, databases, authentication, caching, and testing.' },
  { period: '2019 – 2024', organization: 'Cadi Ayyad University, Marrakech', category: 'University degree', title: 'Bachelor’s Degree in Physics · Electronics and Automation', description: 'Electronic circuits, signals, automated systems, mathematics, and algorithms, with programming in C, C++, and Arduino.' },
];
const certifications = [
  { title: 'Nand to Tetris — Parts I & II', category: 'Systems & algorithms', issuer: 'Hebrew University of Jerusalem' },
  { title: 'Learn to Code with Rust Specialization', category: 'Programming languages', issuer: 'Packt', date: 'Aug 2026' },
  { title: 'IBM Java Developer Specialization', category: 'Programming languages', issuer: 'IBM, SkillUp', date: 'Apr 2026' },
  { title: 'Advanced TypeScript with OOP', category: 'Programming languages', issuer: 'Edureka', date: 'Nov 2025' },
  { title: 'Data Structures and Algorithms Specialization', category: 'Systems & algorithms', issuer: 'University of California San Diego' },
  { title: 'Back End Development and APIs', category: 'Web development', issuer: 'freeCodeCamp', date: 'Nov 2023' },
];
const certificationGroups = ['Systems & algorithms', 'Programming languages', 'Web development'];
---
<Layout title="About — Hamza Boutaleb" description="Meet Hamza Boutaleb, a software engineer who started coding at 13, curious about games, forums, and the systems behind them.">
  <header class="about-heading">
    <h1 id="story" tabindex="-1">About me</h1>
    <a class="text-link resume-link" href="/hamza-boutaleb-resume.pdf" download>Download resume <span class="file-type">PDF</span><span aria-hidden="true">↓</span></a>
  </header>
  <nav class="section-nav" aria-label="About page sections">
      <a href="#story">Story</a>
      <a href="#experience-heading">Experience</a>
      <a href="#education-heading">Education</a>
      <a href="#certifications-heading">Certifications</a>
      <a href="#community-heading">Community</a>
  </nav>
  <div class="about-intro">
    <p>I started programming at 13 because I wanted to understand how games and forums worked. Computers felt like magical machines, and I wanted to figure out what was happening inside them.</p>
    <p>That curiosity led me into web development, from jQuery, JavaScript, and PHP to the tools I use today. Along the way, I explored algorithms, data structures, low-level programming, operating systems, networking, and compilers.</p>
    <p>I still enjoy both sides: building something people can use and understanding the systems that make it work.</p>
  </div>

  <section aria-labelledby="experience-heading">
    <h2 id="experience-heading" tabindex="-1">Experience</h2>
    <ol class="timeline">
      {experience.map(item => (
        <li class="timeline-row">
          <span class="period">{item.period}</span>
          <div class="entry">
            <h3>{item.role}</h3>
            <p class="organization">{item.organization}</p>
            <ul class="responsibilities">{item.details.map(detail => <li>{detail}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="education-heading">
    <h2 id="education-heading" tabindex="-1">Education & training</h2>
    <ol class="timeline">
      {education.map(item => (
        <li class="timeline-row">
          <span class="period">{item.period}</span>
          <div class="entry">
            <span class="education-category">{item.category}</span>
            <h3>{item.organization}</h3>
            <p class="organization">{item.title}</p>
            <p class="detail">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="certifications-heading">
    <h2 id="certifications-heading" tabindex="-1">Certifications</h2>
    <div class="certification-groups">
      {certificationGroups.map((group, index) => (
        <div aria-labelledby={`certificate-group-${index}`}>
          <h3 class="group-title" id={`certificate-group-${index}`}>{group}</h3>
          <ul class="certifications">
            {certifications.filter(item => item.category === group).map(item => (
              <li>
                <div><h4>{item.title}</h4><p class="detail">{item.issuer}</p></div>
                {item.date && <span class="period">{item.date}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="community-heading">
    <h2 id="community-heading" tabindex="-1">Community & achievements</h2>
    <ul class="achievements">
      <li><h3>Founder · Competitive Programming Club</h3><p class="detail">Founded the club at Zone01 Oujda and organized multiple programming contests.</p></li>
      <li><h3>2nd place · AUSIM Cyberdrill, 2026</h3><p class="detail">Earned second place as part of a team in the SecDojo cybersecurity competition.</p></li>
    </ul>
  </section>
  <div class="about-contact">
    <p>Want to work together?</p>
    <a class="text-link" href="/contact">Let’s talk <span aria-hidden="true">↗</span></a>
  </div>
</Layout>

<script>
  import '../scripts/about-navigation';
</script>

<style>
  .about-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); font-size: 0.875rem; text-decoration: none; padding-block: 6px; border-bottom: 1px solid transparent; }
  .text-link:hover { border-bottom-color: currentColor; }
  .file-type { font-size: 0.6875rem; color: var(--muted); }
  .about-contact { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--border); }
  .about-contact p { margin: 0; color: var(--text); font-size: 1rem; }
  .certification-groups { display: grid; gap: 32px; }
  .group-title { margin-bottom: 18px; color: var(--muted); font-size: 0.75rem; font-weight: 500; letter-spacing: normal; }
  .about-intro { max-width: 70ch; }
  .section-nav { position: sticky; top: 0; z-index: 10; display: flex; gap: 20px; overflow-x: auto; margin: 20px 0 28px; padding-block: 12px; border-bottom: 1px solid var(--border); background: var(--background); }
  .section-nav a { display: inline-block; flex-shrink: 0; padding-block: 6px; color: var(--muted); font-size: 0.8125rem; text-decoration: none; }
  .section-nav a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 4px; }
  .section-nav a[aria-current='location'] { color: var(--accent); text-decoration: underline; text-underline-offset: 7px; text-decoration-thickness: 2px; }
  h1[id], h2[id] { scroll-margin-top: 88px; }
  .education-category { display: block; margin-bottom: 5px; color: var(--muted); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
  .about-intro p { font-size: 1rem; line-height: 1.85; margin: 20px 0 0; }
  section { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--border); }
  h2 { margin: 0 0 28px; font-size: 1rem; font-weight: 600; letter-spacing: normal; }
  h3, h4 { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.6; letter-spacing: -0.015em; }
  .timeline, .certifications, .achievements { list-style: none; margin: 0; padding: 0; }
  .timeline { display: grid; gap: 32px; }
  .timeline-row { display: grid; grid-template-columns: 176px minmax(0, 1fr); gap: 28px; }
  .period { color: var(--muted); font-size: 0.75rem; line-height: 1.8; padding-top: 3px; }
  .organization { margin: 4px 0 0; color: var(--text); font-size: 0.875rem; line-height: 1.7; }
  .detail, .responsibilities { color: var(--muted); font-size: 0.875rem; line-height: 1.8; }
  .detail { margin: 8px 0 0; }
  .responsibilities { margin: 12px 0 0; padding-left: 18px; }
  .responsibilities li + li { margin-top: 8px; }
  .certifications { display: grid; gap: 24px; }
  .certifications > li { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; }
  .certifications .period { flex-shrink: 0; }
  .certifications .detail { margin-top: 4px; }
  .achievements { display: grid; gap: 24px; }
  @media (max-width: 640px) {
    section { margin-top: 40px; padding-top: 24px; }
    .timeline-row { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .certifications > li { flex-direction: column; gap: 4px; }
  }
</style>
