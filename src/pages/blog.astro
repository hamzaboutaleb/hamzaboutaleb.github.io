---
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts, formatPostDate, readingMinutes } from '../lib/blog';
const posts = await getPublishedPosts();
---
<Layout title="Blog — Hamza Boutaleb" description="Hamza Boutaleb’s notes on building for the web, understanding computer systems, and learning through programming." blogSearch>
  <section class="writing" aria-labelledby="writing-heading">
    <div class="writing-heading"><h1 id="writing-heading">Latest writing</h1><span id="blog-post-count" role="status" aria-live="polite" aria-atomic="true">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span></div>
    <div class="active-filter" id="blog-tag-filter" hidden>
      <span>Topic: <strong id="selected-blog-tag"></strong></span>
      <button id="clear-blog-tag" type="button">Clear topic <span aria-hidden="true">×</span></button>
    </div>
    {posts.length ? (
      <ul class="post-list" id="blog-post-list">
        {posts.map(post => (
          <li data-search={[post.data.title, post.data.description, ...post.data.tags].join(' ')} data-tags={JSON.stringify(post.data.tags)}>
            <a class="post-link" href={`/blog/${post.id}/`}>
              <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time><span>~{readingMinutes(post.body)} min read</span></div>
              <h2>{post.data.title}<span aria-hidden="true">↗</span></h2>
              <p>{post.data.description}</p>
            </a>
              {post.data.tags.length > 0 && (
                <ul class="post-tags" aria-label="Article topics">
                  {post.data.tags.slice(0, 3).map(tag => <li><button type="button" data-tag={tag} aria-pressed="false" aria-label={`Filter by ${tag}`} disabled>{tag}</button></li>)}
                </ul>
              )}
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty-state"><h2>A space for the things I learn.</h2><p>The first post will appear here.</p></div>
    )}
    <div class="empty-state" id="blog-no-results" hidden>
      <h2>No matching articles.</h2>
      <p>Try a different title, topic, or keyword.</p>
      <button id="clear-blog-search" type="button">Clear filters</button>
    </div>
  </section>
</Layout>

<script>
  import '../scripts/blog-search';
</script>

<style>
  .writing-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .writing-heading h1 { font-size: 1rem; font-weight: 600; line-height: 1.6; letter-spacing: normal; margin: 0; }
  .writing-heading > span { color: var(--muted); font-size: 0.75rem; }
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list > li { border-bottom: 1px solid var(--border); }
  .post-link { display: block; padding: 26px 16px; text-decoration: none; transition: background-color 180ms ease; }
  .post-list > li:has(.post-tags) .post-link { padding-bottom: 14px; }
  .post-link:is(:hover, :focus-visible) { background: color-mix(in srgb, var(--accent) 6%, var(--background)); }
  .post-meta { display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.75rem; color: var(--muted); }
  .post-link h2 { display: flex; align-items: baseline; gap: 20px; justify-content: space-between; font-size: 1.25rem; line-height: 1.4; letter-spacing: -0.025em; font-weight: 600; margin: 12px 0 0; }
  .post-link h2 > span { color: var(--accent); flex-shrink: 0; }
  .post-link:is(:hover, :focus-visible) h2 { color: var(--accent); }
  .post-link p { font-size: 0.875rem; line-height: 1.8; margin-top: 10px; max-width: 72ch; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0 16px 26px; margin: 0; }
  .post-tags button { padding: 5px 9px; border: 1px solid var(--border); border-radius: 4px; background: transparent; color: var(--muted); font: inherit; font-size: 0.6875rem; line-height: 1.5; cursor: pointer; }
  .post-tags button:is(:hover, [aria-pressed="true"]) { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, var(--background)); }
  .post-tags button:disabled { cursor: default; }
  .active-filter { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 16px; border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.8125rem; }
  .active-filter[hidden] { display: none; }
  .active-filter strong { color: var(--text); font-weight: 500; }
  .active-filter button { background: transparent; border: 0; color: var(--accent); font: inherit; padding: 6px 0; cursor: pointer; }
  .empty-state { padding: 40px 0; }
  .empty-state h2 { font-size: 1.125rem; font-weight: 500; letter-spacing: -0.02em; margin: 0; }
  .empty-state p { margin-top: 10px; font-size: 0.875rem; }
  #clear-blog-search { margin-top: 16px; padding: 8px 0; border: 0; background: transparent; color: var(--accent); font: inherit; font-size: 0.8125rem; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  @media (max-width: 520px) {
    .post-link { padding-inline: 8px; }
    .post-tags { padding-inline: 8px; }
    .active-filter { padding-inline: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .post-link { transition: none; } }
</style>
