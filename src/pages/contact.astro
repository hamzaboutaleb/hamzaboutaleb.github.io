---
import Layout from '../layouts/Layout.astro';
import { contact } from '../data/contact';
import SocialIcon from '../components/SocialIcon.astro';
const topics = [
  { title: 'An opportunity', description: 'A role, a team, or an engineering challenge you think I should know about.' },
  { title: 'A project idea', description: 'Something you’re building, a problem you’re exploring, or an idea to exchange.' },
  { title: 'A technical question', description: 'Web development, operating systems, networking, compilers—or how something works.' },
];
---
<Layout title="Contact — Hamza Boutaleb" description="Get in touch with software engineer Hamza Boutaleb by email, GitHub, or LinkedIn.">
  <h1>Let’s talk</h1>
  <p>Have a question, an opportunity, or something interesting to share?</p>
  <div class="email-actions">
    <a class="email" href={`mailto:${contact.email}`}>{contact.email}<span aria-hidden="true">↗</span></a>
    <button id="copy-email" type="button" data-email={contact.email} aria-label="Copy email address" title="Copy email address" hidden>
      <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
      <svg class="copy-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 4 4L19 6" /></svg>
    </button>
    <span id="copy-status" role="status"></span>
  </div>
  <p class="email-note">Tell me a little about yourself and what you have in mind. A few lines are enough.</p>

  <section aria-labelledby="topics-title">
    <h2 id="topics-title">A few good starting points</h2>
    <ul class="topics">
      {topics.map(topic => (
        <li>
          <a href={`mailto:${contact.email}?subject=${encodeURIComponent(topic.title)}`} aria-label={`Email me about ${topic.title.toLowerCase()}`}>
            <span class="topic-title">{topic.title}<span aria-hidden="true">↗</span></span>
            <span class="topic-description">{topic.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="elsewhere-title">
    <h2 id="elsewhere-title">Elsewhere on the web</h2>
    <div class="social-links">
      <a href={contact.github}><span class="social-title"><SocialIcon name="GitHub" />GitHub<span aria-hidden="true">↗</span></span><span class="social-description">Explore my code and projects.</span></a>
      <a href={contact.linkedin}><span class="social-title"><SocialIcon name="LinkedIn" />LinkedIn<span aria-hidden="true">↗</span></span><span class="social-description">Connect with me professionally.</span></a>
    </div>
  </section>
</Layout>

<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-email');
  const status = document.getElementById('copy-status');
  let feedbackTimer: ReturnType<typeof setTimeout>;

  if (button && navigator.clipboard?.writeText) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const email = button.dataset.email;
      if (!email) return;
      clearTimeout(feedbackTimer);
      button.disabled = true;
      delete button.dataset.copied;
      button.setAttribute('aria-label', 'Copy email address');
      button.title = 'Copy email address';
      if (status) status.textContent = '';
      try {
        await navigator.clipboard.writeText(email);
        button.dataset.copied = 'true';
        button.setAttribute('aria-label', 'Email copied');
        button.title = 'Email copied';
        if (status) status.textContent = 'Copied';
        feedbackTimer = setTimeout(() => {
          delete button.dataset.copied;
          button.setAttribute('aria-label', 'Copy email address');
          button.title = 'Copy email address';
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        if (status) status.textContent = 'Couldn’t copy. Please copy the address manually.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .email-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .email {
    display: inline-flex;
    align-items: baseline;
    gap: 16px;
    max-width: 100%;
    padding: 8px 0;
    color: var(--accent);
    font-size: clamp(1rem, 3vw, 1.25rem);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    overflow-wrap: anywhere;
  }
  .email span { flex-shrink: 0; }
  .email:hover { box-shadow: 0 1px 0 currentColor; }
  #copy-email { width: 44px; height: 44px; flex-shrink: 0; padding: 12px; border: 1px solid var(--border); border-radius: 5px; background: transparent; color: var(--muted); cursor: pointer; }
  #copy-email:hover, #copy-email[data-copied='true'] { color: var(--accent); border-color: var(--accent); }
  #copy-email svg { width: 18px; height: 18px; }
  .copy-check { display: none; }
  #copy-email[data-copied='true'] .copy-icon { display: none; }
  #copy-email[data-copied='true'] .copy-check { display: block; }
  #copy-status { font-size: 0.75rem; color: var(--muted); }
  .email-note { max-width: 54ch; margin-top: 12px; font-size: 0.875rem; line-height: 1.8; }
  section { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--border); }
  h2 { margin: 0; font-size: 1rem; font-weight: 600; }
  .topics { list-style: none; margin: 20px 0 0; padding: 0; }
  .topics li + li { margin-top: 12px; }
  .topics a { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 12px 0; text-decoration: none; }
  .topic-title { display: inline-flex; align-items: baseline; justify-self: start; align-self: start; gap: 12px; padding-bottom: 3px; border-bottom: 1px solid transparent; font-size: 0.875rem; font-weight: 600; }
  .topic-title > span { color: var(--accent); }
  .topic-description { max-width: 72ch; font-size: 0.8125rem; color: var(--muted); line-height: 1.8; }
  .topics a:is(:hover, :focus-visible) .topic-title { color: var(--accent); border-bottom-color: currentColor; }
  .social-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 20px; }
  .social-links > a { display: block; padding: 20px 18px; border-radius: 6px; text-decoration: none; transition: background-color 180ms ease; }
  .social-title { display: flex; align-items: center; gap: 9px; font-size: 0.875rem; font-weight: 600; }
  .social-title :global(svg) { width: 17px; height: 17px; flex-shrink: 0; }
  .social-title > span { margin-left: 3px; color: var(--accent); }
  .social-description { display: block; margin-top: 9px; font-size: 0.8125rem; color: var(--muted); }
  .social-links a:is(:hover, :focus-visible) { background-color: color-mix(in srgb, var(--accent) 6%, var(--background)); }
  .social-links a:is(:hover, :focus-visible) .social-title { color: var(--accent); }
  @media (max-width: 520px) {
    .social-links { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-links > a { transition: none; }
  }
</style>
